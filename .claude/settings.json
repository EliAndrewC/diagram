{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/diagram/scripts/clone-sync-hooks.sh prompt",
            "timeout": 60,
            "statusMessage": "Syncing session clone with main..."
          },
          {
            "type": "command",
            "command": "/diagram/scripts/idle-tests-hooks.sh prompt",
            "timeout": 30,
            "statusMessage": "Disarming the idle-tests timer; surfacing its last verdict..."
          },
          {
            "type": "command",
            "command": "/diagram/scripts/agent-stall-hooks.sh prompt",
            "timeout": 15,
            "statusMessage": "Checking for stalled background agents..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/diagram/scripts/clone-sync-hooks.sh pretool",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/diagram/scripts/batching-hooks.sh pretool",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/diagram/scripts/no-poll-hooks.sh pretool",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/diagram/scripts/gate-hooks.sh pretool",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/diagram/scripts/no-branch-hooks.sh pretool",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/diagram/scripts/discard-hooks.sh pretool",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/diagram/scripts/make-only-hooks.sh pretool"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/diagram/scripts/guard-file-hooks.sh pretool"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/diagram/scripts/readme-hooks.sh pretool"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/diagram/scripts/repo-safety-hooks.sh pretool"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/diagram/scripts/house-style-hooks.sh pretool"
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/diagram/scripts/source-block-hooks.sh pretool"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/diagram/scripts/measure-hooks.sh pretool",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/diagram/scripts/pair-hooks.sh pretool"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "/diagram/scripts/pair-hooks.sh pretool"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/diagram/scripts/batching-hooks.sh posttool",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/diagram/scripts/idle-tests-hooks.sh stop",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "/diagram/scripts/pair-hooks.sh stop"
          }
        ]
      }
    ]
  }
}
