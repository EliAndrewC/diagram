diff -ruN rust-clean/guard/shared/src/t507.rs rust/guard/shared/src/t507.rs
--- rust-clean/guard/shared/src/t507.rs	1969-12-31 19:00:00.000000000 -0500
+++ rust/guard/shared/src/t507.rs	2026-11-27 08:54:50.891286159 -0500
@@ -0,0 +1,61 @@
+//! 451 T507 SCRATCH: stamps of wall time, the process's CPU (`clock_gettime`, ns) and page faults (`/proc/self/stat`),
+//! kept in memory and appended to `$T507_STAMPS` at the end of main. Never in the tree.
+use std::sync::{Mutex, OnceLock};
+use std::time::Instant;
+
+static T0: OnceLock<Instant> = OnceLock::new();
+static LOG: Mutex<Vec<String>> = Mutex::new(Vec::new());
+
+#[repr(C)]
+struct Ts {
+    s: i64,
+    ns: i64,
+}
+extern "C" {
+    fn clock_gettime(id: i32, ts: *mut Ts) -> i32;
+}
+
+/// The process's CPU, ns: `CLOCK_PROCESS_CPUTIME_ID` (2), exact at the call, where `/proc/self/schedstat` moves only at ticks.
+fn cpu_ns() -> u64 {
+    let mut ts = Ts { s: 0, ns: 0 };
+    // SAFETY: glibc's clock_gettime writes one timespec into a valid pointer
+    unsafe { clock_gettime(2, &mut ts) };
+    (ts.s as u64) * 1_000_000_000 + ts.ns as u64
+}
+
+fn faults() -> (u64, u64) {
+    let s = std::fs::read_to_string("/proc/self/stat").unwrap_or_default();
+    let rest = s.rsplit_once(')').map_or("", |(_, r)| r);
+    let f: Vec<&str> = rest.split_whitespace().collect();
+    // after the name: state(3) ... minflt(10) cminflt(11) majflt(12)
+    let at = |i: usize| f.get(i).and_then(|v| v.parse().ok()).unwrap_or(0);
+    (at(7), at(9))
+}
+
+pub fn stamp(label: &str) {
+    let t = T0.get_or_init(Instant::now).elapsed().as_nanos();
+    let (mi, ma) = faults();
+    let c = cpu_ns();
+    if let Ok(mut l) = LOG.lock() {
+        l.push(format!("{label}\t{t}\t{c}\t{mi}\t{ma}"));
+    }
+}
+
+/// Stamps `label` when dropped.
+pub struct OnDrop(pub &'static str);
+impl Drop for OnDrop {
+    fn drop(&mut self) {
+        stamp(self.0);
+    }
+}
+
+pub fn flush() {
+    use std::io::Write as _;
+    let Ok(p) = std::env::var("T507_STAMPS") else {
+        return;
+    };
+    let Ok(l) = LOG.lock() else { return };
+    if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(p) {
+        let _ = writeln!(f, "{}\n--", l.join("\n"));
+    }
+}
