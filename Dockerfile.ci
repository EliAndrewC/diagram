# The CodeBuild image for the diagram gate (feature 130). Built ON CodeBuild by `make ci-image`
# (buildspec/image.yml) - the laptop never needs Docker - and pushed to ECR as :latest.
#
# ubuntu:26.04 because that is what the dev container runs: the same apt `resvg` (0.46) and DejaVu
# faces, the same system Python 3.14, so a render or a font that differs between laptop and build
# is a bug rather than an environment. ONE source of truth for what "installed" means: the same
# container-scripts/setup-dev-env.sh the laptop runs, in --image mode (no claude() wrapper, no
# ~/.bashrc, no boto3 - the build talks to S3 through the AWS CLI installed below).
FROM ubuntu:26.04
ENV DEBIAN_FRONTEND=noninteractive PIP_BREAK_SYSTEM_PACKAGES=1 PYTHONDONTWRITEBYTECODE=1
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
        python3 python3-pip git make curl ca-certificates unzip util-linux \
    && rm -rf /var/lib/apt/lists/*
# the AWS CLI v2 - the build's S3 reads and writes go through it with the service role
RUN curl -sS "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscli.zip \
    && unzip -q /tmp/awscli.zip -d /tmp && /tmp/aws/install && rm -rf /tmp/aws /tmp/awscli.zip
COPY container-scripts/setup-dev-env.sh /tmp/repo/container-scripts/setup-dev-env.sh
COPY .claude/skills/diagram/requirements.txt .claude/skills/diagram/requirements-dev.txt /tmp/repo/.claude/skills/diagram/
RUN apt-get update -qq && bash /tmp/repo/container-scripts/setup-dev-env.sh --image && rm -rf /var/lib/apt/lists/* /tmp/repo
RUN resvg --version && python3 --version && git --version && aws --version
