# The CodeBuild image for the diagram gate (feature 130). Built ON CodeBuild by `make ci-image`
# (buildspec/image.yml) - the laptop never needs Docker - and pushed to ECR as :latest.
#
# ubuntu:26.04 because that is what the dev container runs: the same apt `resvg` (0.46) and DejaVu
# faces, the same system Python 3.14. The pinned lockfiles go into a venv through uv - the SAME
# route buildspec/run.sh uses to bootstrap the stock image (proven on builds d73cac86, 81359962) -
# because system pip on 26.04 refuses to replace Debian-packaged dependencies
# (`uninstall-no-record-file`, build b3617f0d). The venv is first on PATH, so `python3` IS 3.14
# with the lockfiles, and `make` needs no environment of its own.
# ECR Public rather than Docker Hub: CodeBuild's shared egress is rate-limited by Docker Hub
# (429 Too Many Requests, build 5b376edc); Canonical publishes the same image on ECR Public.
FROM public.ecr.aws/ubuntu/ubuntu:26.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 PATH=/opt/venv/bin:/root/.local/bin:/usr/local/bin:/usr/bin:/bin
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
        python3 git make curl ca-certificates unzip util-linux \
        resvg fonts-dejavu-core fonts-dejavu-extra \
    && rm -rf /var/lib/apt/lists/*
# the AWS CLI v2 - the build's S3 reads and writes go through it with the service role
RUN curl -sS "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscli.zip \
    && unzip -q /tmp/awscli.zip -d /tmp && /tmp/aws/install && rm -rf /tmp/aws /tmp/awscli.zip
COPY .claude/skills/diagram/requirements.txt .claude/skills/diagram/requirements-dev.txt /tmp/req/
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
    && uv venv -q --python 3.14 /opt/venv \
    && uv pip install -q --python /opt/venv/bin/python -r /tmp/req/requirements.txt -r /tmp/req/requirements-dev.txt \
    && rm -rf /tmp/req
RUN resvg --version && python3 --version && python3 -c "import shapely, PIL, pytest, xdist" && pyrefly --version && git --version && aws --version
