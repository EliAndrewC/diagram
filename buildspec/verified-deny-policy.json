{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyTheBuildWritesVerifiedRecords",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::gm-assistant-ci-130071571821/verified/*",
      "Condition": {
        "StringNotLike": {
          "aws:PrincipalArn": [
            "arn:aws:iam::130071571821:role/gm-assistant-codebuild-role",
            "arn:aws:sts::130071571821:assumed-role/gm-assistant-codebuild-role/*"
          ]
        }
      }
    }
  ]
}
