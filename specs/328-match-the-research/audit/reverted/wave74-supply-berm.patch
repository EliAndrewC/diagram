+def test_the_planted_ground_stands_every_supply_canals_half_width_and_its_berm_back() -> None:
+    # Canal A runs across the fan's head at y = 100, the fall +y, in two pieces narrowing 10 -> 4 px; at grain 1 the
+    # 5.0 ft berm is 2.5 px, so the ground starts 7.5 px below the centerline at the wide end and 4.5 px at the narrow.
+    # Canal B leaves it down the fall at x = 300, 4 px wide: 2 + 2.5 px bare each side. A delivery ditch keeps a bund's margin.
+    env = [(0.0, 0.0), (400.0, 0.0), (400.0, 400.0), (0.0, 400.0)]
+    a_pts = [(-50.0, 100.0), (450.0, 100.0)]
+    chan = [  # a piece is sampled in several points, as `_comb_canal_pieces` lays them: the bank tapers segment by segment
+        {"pts": [(-50.0 + 25.0 * k, 100.0) for k in range(11)], "w": 10.0, "w_tail": 7.0, "role": "main"},
+        {"pts": [(200.0 + 25.0 * k, 100.0) for k in range(11)], "w": 7.0, "w_tail": 4.0, "role": "main"},
+        {"pts": [(300.0, 100.0 + 31.0 * k) for k in range(11)], "w": 4.0, "w_tail": 4.0, "role": "main"},
+        {"pts": [(100.0, 100.0 + 31.0 * k) for k in range(11)], "w": 2.0, "w_tail": 2.0, "role": "branch"},
+    ]
+    assert pt.supply_canals(chan) == chan[:3], "the supply canals are the main pieces, not a delivery ditch"
+    region = pt.planted_region(_Frame(90.0), env, chan, a_pts, [(-500.0, 900.0), (900.0, 900.0)], 1.0, lambda _u: 2.0)
+    assert not region.intersects(_box(10, 0, 12, 99)), "nothing is planted upslope of the canal"
+    assert not region.intersects(_box(10, 105, 12, 106.5)), "the wide end's half-width and berm are bare"
+    assert region.contains(_box(10, 108, 12, 110)), "and planting starts just past them"
+    assert region.contains(_box(380, 105.5, 382, 107)), "the bank narrows with the canal: the old flat 8 px left this bare"
+    assert not region.intersects(_box(295.6, 200, 304.4, 202)), "canal B keeps its half-width and berm bare on both sides"
+    assert region.contains(_box(304.6, 200, 306, 202)) and region.contains(_box(294, 200, 295.4, 202)), "and planting starts past them"
+    assert region.contains(_box(102.0, 200, 103, 202)), "a delivery ditch is bordered by the bund alone"
+
+
