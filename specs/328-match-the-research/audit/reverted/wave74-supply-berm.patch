+def polygonal(geom: Any) -> Any:
+    """`geom` less any zero-area leftovers: a difference can return a GeometryCollection carrying a line where two cut edges
+    meet (the canal's bank against the envelope on cohort seed 7), and the sectors read only polygons.
+
+    Research: polygonal region - NONE: geometry hygiene
+    """
+    if geom.geom_type != "GeometryCollection":
+        return geom
+    from shapely.ops import unary_union
+
+    return unary_union([p for p in geom.geoms if p.geom_type in ("Polygon", "MultiPolygon")])
+
+
+def supply_canals(channels: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    """The fan's supply canals - the head race and canals A and B, every `main` piece - whose banks the planted ground stands
+    back from: the bare earth bank between a supply canal and the fields beside it (0055, 0068). A delivery ditch (`branch`)
+    is bordered by the paddy's own bund, and the drain by the drain's bank.
+
+    Research: the canals with a bank - research/questions/0055-where-a-field-meets-its-ditch-the-bank-the-bund-and-the-inlet-mizuguchi.drawing.html: a bare earth bank 5 ft wide runs between a supply canal and the fields beside it
+    """
+    return [c for c in channels if c.get("role") == "main"]
 
 
