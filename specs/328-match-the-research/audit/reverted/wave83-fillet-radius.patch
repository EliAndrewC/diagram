+def test_a_filleted_bend_is_a_circular_arc_of_the_radius_given() -> None:
+    """Feature 328 wave 83 (0054: a bend of about 2.5 channel widths' radius): `fillet_polyline`'s `radius` is the bend's
+    radius - a gentle 20-degree turn on long legs is an arc 10 px in radius, not the 10 px cut-back whose quadratic bent it
+    ~57 px wide - and the radius is capped at 35% of the shorter leg."""
+    import math
+
+    from l7r.diagram.settlement._geom.curves import fillet_polyline
+
+    turn = math.radians(20.0)
+    pts = [(0.0, 0.0), (200.0, 0.0), (200.0 + 200.0 * math.cos(turn), 200.0 * math.sin(turn))]
+    arc = fillet_polyline(pts, 10.0)[1:-1]
+    cx, cy = 200.0 - 10.0 * math.tan(turn / 2), 10.0  # the center: one radius in from the first leg, at the tangent point
+    assert all(abs(math.dist(q, (cx, cy)) - 10.0) < 1e-6 for q in arc), "every arc point one radius from its center"
+    short = fillet_polyline([(0.0, 0.0), (20.0, 0.0), (20.0, 200.0)], 10.0)[1:-1]
+    assert abs(math.dist(short[0], (20.0, 0.0)) - 7.0) < 1e-6, "a right angle on a 20 px leg: the radius capped at 7"
