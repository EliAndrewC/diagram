+def run_on(pts: list[Pt], down: Pt) -> Pt:
+    """The unit heading a thread runs on past its end: its last segment's, where that descends at least a third as steeply as
+    the fall itself (cos 70 deg); else the fall (`down`), as for a thread of one point - a thread that ends running along the contour has no convergence to
+    carry, and a heading that barely falls would carry it off the fan.
+
+    Research:
+        run on as it heads - research/questions/0005-rice-paddies-and-their-plots-suiden.drawing.html: the bunds converge with the fan toward its drain
+        the heading's floor - UNRESEARCHED: a last heading falling at under cos 70 deg (0.34) of the fall gives way to the fall
+    """
+    if len(pts) < 2:
+        return down
+    (ax, ay), (bx, by) = pts[-2], pts[-1]
+    lx, ly = bx - ax, by - ay
+    ln = math.hypot(lx, ly)
+    if ln < 1e-9 or (lx * down[0] + ly * down[1]) / ln < 0.34:
+        return down
+    return (lx / ln, ly / ln)
+
